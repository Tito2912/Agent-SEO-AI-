---
import Base from '../layouts/Base.astro';
const canonical = 'http://127.0.0.1:8741/liens';
// TWO MORE INJECTED DEFECTS, both in a rewriter the canonical loop never exercised:
//  * the <a href> points at a URL the host 301s away from  -> page_has_links_to_redirect,
//    repaired by _rewrite_redirect_links (a DIFFERENT rewriter from the canonical one).
//  * the <img src> does the same                           -> page_has_redirected_image /
//    image_redirects, repaired by _rewrite_asset_srcs.
---
<Base
  title="Liens du site de test Astro"
  description="Page qui pointe deliberement vers des URL que l'hebergeur redirige, pour exercer la reecriture des liens et des ressources."
  canonical={canonical}
>
  <p>Voir <a href="http://127.0.0.1:8741/a-propos/">la page a propos</a>.</p>
  <img src="http://127.0.0.1:8741/og.png/" alt="Logo du site de test" width="1" height="1" />
</Base>
