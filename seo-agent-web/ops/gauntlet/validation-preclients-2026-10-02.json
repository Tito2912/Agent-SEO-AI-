  "fixed_customer_defects": [
    {
      "defect": "The last preview credit prevented its confirmation, including auto mode.",
      "before_fix": "Authenticated preview succeeds and bills one credit; confirmation returns 402.",
      "fix": "Confirmation still checks plan access but does not require another model credit or bill twice."
    },
    {
      "defect": "Simultaneous correction requests could spend the same last credit.",
      "before_fix": "A blocked first model call leaves the last credit available to a second request.",
      "fix": "Serialize correction operations by project payer across all five correction routes and account members; a concurrent operation returns 409 with Retry-After."
    },
    {
      "defect": "Quota read/write errors were swallowed.",
      "before_fix": "A quota read failure was treated as unlimited; an unrecorded debit could be returned as success.",
      "fix": "Refuse with 503 when the correction/quota store is unavailable. This does not make external GitHub writes and ledger writes atomic."
    },
    {
      "defect": "Individual preview/confirmation allowed duplicate PRs and repeated paid previews.",
      "before_fix": "A second confirmation creates another PR; preview regenerates and bills while a PR for the same issue/page is open.",
      "fix": "Reuse the existing open-PR guard before provider/branch work; return 409 and the existing PR URL. Closed PRs do not block a fresh correction."
    }
  ],
  "reproduction": {
    "initial_customer_tests_before_fix": {
      "failed": 3,
      "passed": 1
    },
    "repeat_click_tests_before_fix": {
      "failed": 2,
      "passed": 1
    },
    "test_files": [
      "tests/test_corrector_customer_workflow.py",
      "tests/test_correction_guard.py"
    ],
    "authenticated_client_api": "real FastAPI routes, auth, CSRF, payer attribution and SQLite billing ledger; fake GitHub/model for deterministic fault/concurrency tests",
    "sqlite_mutex": "OS-level exclusion between separate processes, independent payers, nested auto confirmation, body exceptions, abrupt worker exit and copied-thread context",
    "postgres_mutex": "Protocol tests only: advisory session lock, commit without a long transaction, busy refusal, cleanup and connection invalidation. No real PostgreSQL server was exercised."
  },
  "evidence_notes": [
    "No fixture main branch was changed. Every created preview PR was closed without merging.",
    "This stage made no additional Claude calls. Model-written families were skipped, not certified.",
    "Netlify adds noindex to previews. A family missing from the unchanged baseline remains unverified, even when its after-counter is zero.",
    "Canonical 4xx and internal HTTP links passed separate positive-control HTML field checks on all six stacks; these are not crawler-count proofs.",
    "Missing reciprocal hreflang remains unverified where preview indexability suppresses it. No patch is not a successful repair.",
    "Open Graph URL/canonical remains partial (4 to 1) on Hugo, Gatsby and Nuxt: the surviving route is /gauntlet/canonical-http/. Its insecure canonical was deliberately outside the mechanical-only batch; the OG guard refuses to copy it.",
    "Resolution and absence of regressions are limited to the observed preview scope. Passing builds and aggregate count reductions do not certify every client anomaly.",
    "The full local suite was rerun after all source edits, because a run started before the last app edit invalidated line-based source-inspection tests.",
    "Unrelated pre-existing whitespace in app.py was left intact."
  ],
  "remaining_release_checks": [
    "Validate the PostgreSQL mutex with a real isolated database, multiple workers, connection loss and enough concurrent accounts to measure connection-pool capacity; advisory session locks require session-compatible pooling.",
    "Validate recovery/idempotency when GitHub has accepted an external write but the quota/task ledger write fails. A 503 is honest but is not transactional rollback.",
    "Exercise the remaining Claude-written families and finish partial batches on the additional stacks with explicit call budgets.",
    "Validate reciprocal/invalid hreflang and other indexability-sensitive families where the unchanged defect is observable.",
    "Exercise real paid-account onboarding, GitHub permissions, quota renewal, upgrade/downgrade and Stripe/provider failures.",
    "Review and deploy the local changes, then run supervised pilots with draft PRs and human review before enabling wider automation."
  ],
